<Window x:Class="LogFilterApp.SavePathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salvar diretorio no historico"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="16">
        <TextBlock Text="Deseja salvar este diretorio no historico?" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock x:Name="TxtPath" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,12"/>

        <Label Margin="0,0,0,2">Alias (opcional):</Label>
        <TextBox x:Name="TxtAlias" Margin="0,0,0,16"
                 ToolTip="Ex: Logs Producao, Logs QA, etc."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salvar" Click="BtnSave_Click" Padding="16,6" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="Nao salvar" Click="BtnCancel_Click" Padding="16,6" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
